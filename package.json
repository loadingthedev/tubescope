{
  "name": "tubescope",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run --parallel --filter '@tubescope/*' --if-present dev",
    "start": "bun run --filter @tubescope/api start",
    "build": "bun run --workspaces --if-present build",
    "test": "bun run --workspaces --if-present test",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "snapshot": "bun run --filter @tubescope/api snapshot"
  }
}
