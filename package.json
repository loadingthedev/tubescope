{
  "name": "tubescope",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run --parallel --filter '@tubescope/*' --if-present dev",
    "start": "bun run --filter @tubescope/api start",
    "build": "bun run --workspaces --if-present build",
    "test": "bun run --workspaces --if-present test",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "snapshot": "bun run --filter @tubescope/api snapshot",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint --no-script",
    "lint:fix": "bun lint --no-script --fix",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prepare": "hooks_dir=\"$(git rev-parse --git-path hooks)\" && mkdir -p \"$hooks_dir\" && ln -sf \"$(pwd)/scripts/pre-commit\" \"$hooks_dir/pre-commit\""
  }
}
